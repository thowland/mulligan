# Deploy settings: copy to deploy.env (gitignored) and fill in.
# Both `pnpm infra:deploy` and `pnpm deploy:site` read it, and anything
# set in the shell wins over it:  STACK_NAME=mulligan-test pnpm infra:deploy

# The AWS CLI profile for every call.
AWS_PROFILE=your-profile

# The beta-site.us Route 53 zone, without the /hostedzone/ prefix:
#   aws route53 list-hosted-zones --query "HostedZones[?Name=='beta-site.us.'].Id" --output text
HOSTED_ZONE_ID=

# Optional overrides of the script defaults.
# STACK_NAME=mulligan
# DOMAIN_NAME=mulligan.beta-site.us
