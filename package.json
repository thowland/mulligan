{
  "name": "mulligan",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @mulligan/web dev",
    "preview": "pnpm --filter @mulligan/web preview",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0 && prettier --check . && depcruise packages apps --config .dependency-cruiser.cjs && pnpm typecheck",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --project core:node --project core:chromium --project render:chromium --project web:jsdom --project tooling:node",
    "test:browsers": "vitest run --project core:firefox --project core:webkit --project render:firefox --project render:webkit",
    "test:e2e": "playwright test",
    "gate": "pnpm lint && pnpm test:coverage && pnpm test:browsers && pnpm build && pnpm test:e2e",
    "readme:screenshots": "node tooling/scripts/readme-screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
