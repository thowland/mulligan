{
  "name": "@mulligan/core",
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "description": "Mulligan rules library: store presets, listing field definitions, normalization and checks.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./standards.json": "./src/standards/standards.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./standards.json": "./dist/standards.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && cp src/standards/standards.json dist/standards.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "standards:lock": "node scripts/standards-lock.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "fixtures:text": "node scripts/text-fixtures.ts"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0"
  }
}
